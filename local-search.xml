    <content type="html"><![CDATA[<p>dsadsdsdsclass SimpleWAF {<br>    &#x2F;&#x2F; 跳转目标URLs奥瑟<br>    private $blockPage &#x3D; ‘<a href="http://127.0.0.1/blocked.php">http://127.0.0.1/blocked.php</a>‘;</p><pre><code>// 恶意特征匹配规则   private $rules = array(// 规则1：检测包含#符号，且其后有SELECT和and的模式&#39;/([#]).*?\bSELECT\b.*?\band\b/!&#39;,// 规则2：检测包含SELECT和#的模式&#39;/\bSELECT\b.*?[#]/!&#39;,// 规则3：检测包含#和AND的模式&#39;/[#].*?\band\b/i&#39;,// 规则4：检测单独的SELECT关键字&#39;/\bSELECT\b/i&#39;,// 规则5：检测单独的AND关键字&#39;/\band\b/i&#39;,// 规则6：检测#符号&#39;/[#]/&#39;</code></pre><p>);</p>]]></content>
    
    
    
